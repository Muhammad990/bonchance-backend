# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/backend-server

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated origins allowed to hit the API (React dev server)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000